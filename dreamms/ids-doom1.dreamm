//
// Doom
//
desc[ids-doom1]:

name = Doom
icon = ids-doom1.png
machine = pc
osenv = dos
rootpath = C:\
EXEC = DOOM
mips = $(MIPS_486DX4_100)
ramkb = 8192
filter = id software, fps
videohw = vga

$(include cfg-doom.inc)

//
// filesystem
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)  ; writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// v0.2 1993-02-04
//
demo[v0.2]:
    name = v0.2 Pre-Alpha Tech Demo 1993-02-04
    anchorfile = DOOM.WAD
    launch = $(rootpath)\DOOM.EXE
    file[]: crc = ab5e87f7; size =    259177; name = doom.exe
    file[]: crc = 2587d97b; size =    496250; name = doom.wad
    file[]: crc = 55969e60; size =       118; name = readme.txt
end

//
// doom02 1993-02-04
//
demo[slides1]:
    name = Pre-Alpha Slide Show 1993-02-04
    anchorfile = SCRN2_00.LBM
    launch = "$(rootpath)\SK.EXE" -n *.lbm
    file[]: crc = 817e90df; size =     49352; name = SCRN2_00.LBM
    file[]: crc = 2c1d5cd7; size =     46706; name = SCRN2_01.LBM
    file[]: crc = 5560f758; size =     48850; name = SCRN2_02.LBM
    file[]: crc = 942b6a80; size =     47952; name = SCRN2_03.LBM
    file[]: crc = d5190486; size =     10796; name = SK.EXE
end

//
// doompix1.exe (same as doom04.zip without batch file)
