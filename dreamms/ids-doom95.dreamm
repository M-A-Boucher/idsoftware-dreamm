//
// video configuration
//
config[video]:
	condition = ("$$(GAMEID)" == 0)
    title = Video Configuration
    option[window]:  name = Cropped to Window; wincrop = true
    option[desktop]: name = Full Desktop;      wincrop = false; priority = 1
end

//
// video configuration outside launcher
//
config[vidsize]:
	condition = ("$$(GAMEID)" != 0)
    title = Video Configuration
    option[200w]:  name = 320×200 WINDOW; RESOLUTION = -320x200w; winres = 640x480x8; wincrop = false
    option[240w]:  name = 320×240 WINDOW; RESOLUTION = -320x240w; winres = 640x480x8; wincrop = false
    option[400w]:  name = 640×400 WINDOW; RESOLUTION = -640x400w; winres = 640x480x8; wincrop = false
