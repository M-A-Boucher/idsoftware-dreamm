//
// 1x720K, Installer
//
installer[1x720k-installer]:
    name = 1x720K, Installer
    installid = v1.0
    mips = $(MIPS_MAX)
    launch = KEEN123.EXE
    anchorfile = KEEN123.EXE
    file[]: crc = 2542e795; size =    431611; name = KEEN123.EXE
end

//
// 2x360K, Installer
//
