//
// Doom 2 Master Levels Map
//
config[mastermap]:
	condition = ("$$(SKILLSTART)" > 0) && ("$$(GAMEID)" == 7)
    title = Start on Master Map
    option[warp1]: name = Attack (attack.wad); WARP = -file $(rootpath)\MASTER\WADS\attack.wad -WARP 1 -nowarn; priority = 1
	option[warp2]: name = Black Tower (blacktwr.wad); WARP = -file $(rootpath)\MASTER\WADS\blacktwr.wad -WARP 25 -nowarn
    option[warp3]: name = Bloodsea (bloodsea.wad); WARP = -file $(rootpath)\MASTER\WADS\bloodsea.wad -WARP 7 -nowarn
	option[warp4]: name = Canyon (canyon.wad); WARP = -file $(rootpath)\MASTER\WADS\canyon.wad -WARP 1 -nowarn
	option[warp5]: name = The Catwalk (catwalk.wad); WARP = -file $(rootpath)\MASTER\WADS\catwalk.wad -WARP 1 -nowarn
	option[warp6]: name = The Combine (combine.wad); WARP = -file $(rootpath)\MASTER\WADS\combine.wad -WARP 1 -nowarn
	option[warp7]: name = The Fistula (fistula.wad); WARP = -file $(rootpath)\MASTER\WADS\fistula.wad -WARP 1 -nowarn
	option[warp8]: name = Garrison (garrison.wad); WARP = -file $(rootpath)\MASTER\WADS\garrison.wad -WARP 1 -nowarn
	option[warp9]: name = Geryon (geryon.wad); WARP = -file $(rootpath)\MASTER\WADS\geryon.wad -WARP 8 -nowarn
    option[warp10]: name = Manor (manor.wad); WARP = -file $(rootpath)\MASTER\WADS\manor.wad -WARP 1 -nowarn
    option[warp11]: name = Mephisto's Maosoleum (mephisto.wad); WARP = -file $(rootpath)\MASTER\WADS\mephisto.wad -WARP 7 -nowarn
	option[warp12]: name = Minos' Judgement: 4th Canto of INFERNO (minos.wad); WARP = -file $(rootpath)\MASTER\WADS\minos.wad -WARP 5 -nowarn
    option[warp13]: name = Nessus: 5th Canto of INFERNO (nessus.wad); WARP = -file $(rootpath)\MASTER\WADS\nessus.wad -WARP 7 -nowarn
	option[warp14]: name = Paradox (paradox.wad); WARP = -file $(rootpath)\MASTER\WADS\paradox.wad -WARP 1 -nowarn
	option[warp15]: name = Subspace (subspace.wad); WARP = -file $(rootpath)\MASTER\WADS\subspace.wad -WARP 1 -nowarn
	option[warp16]: name = Subterra (subterra.wad); WARP = -file $(rootpath)\MASTER\WADS\subterra.wad -WARP 1 -nowarn
	option[warp17]: name = The Express Elevator to Hell (teeth.wad); WARP = -file $(rootpath)\MASTER\WADS\teeth.wad -WARP 31 -nowarn
	option[warp18]: name = Bad Dream (teeth.wad); WARP = -file $(rootpath)\MASTER\WADS\teeth.wad -WARP 32 -nowarn
	option[warp19]: name = Trapped on Titan (ttrap.wad); WARP = -file $(rootpath)\MASTER\WADS\ttrap.wad -WARP 1 -nowarn
	option[warp20]: name = Vesperas: 7th Canto of INFERNO(vesperas.wad); WARP = -file $(rootpath)\MASTER\WADS\vesperas.wad -WARP 9 -nowarn
	option[warp21]: name = Virgil's Lead: 3rd Canto of INFERNO (virgil.wad); WARP = -file $(rootpath)\MASTER\WADS\virgil.wad -WARP 3 -nowarn

end

