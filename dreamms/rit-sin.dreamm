//
// Sin
//
desc[rit-sin]:

name = Sin
icon = rit-sin.png
machine = pc
osenv = windows
rootpath = C:\
launch = $(rootpath)\sin.exe
mips = $(MIPS_MAX)
winres = 1600x1200
audiohw = gmidi
filter = ritual, fps

MODERN_KEYBINDS = [[[$(CRLF)
    bind w "+forward"
    bind a "+moveleft"
    bind s "+back"
    bind d "+moveright"
    bind MWHEELUP "weapnext"
    bind MWHEELDOWN "weapnext"
    bind CTRL "+movedown"
    bind q "invprev"
    bind e "invnext"
    bind r "invuse"
    unbind PGDN
    unbind END
    unbind INS
    unbind /
    unbind c
    unbind ,
    unbind .
    +mlook
    sensitivity "11"
    cl_run "1"
]]]

//
// controls configuration
//
config[controls]:
    title = Controls Configuration
    option[classic]:
        name = Customize In-Game (No Overrides)
        KEYBIND_OVERRIDE = $(NULL)
    end
    option[mouse]:
        name = Modern Preset (WASD + Mouse)
        KEYBIND_OVERRIDE = [[[$(CRLF)
            $(MODERN_KEYBINDS)
            m_pitch "0.022"
        ]]]
    end
    option[mouse-inverted]:
        name = Modern Preset (WASD + Inverted Mouse)
        KEYBIND_OVERRIDE = [[[$(CRLF)
            $(MODERN_KEYBINDS)
            m_pitch "-0.022"
        ]]]
    end
end

//
// renderer configuration
//
config[renderer]:
    title = Renderer Configuration
    option[software]:
        name = Software
        RENDERER_OVERRIDE = set vid_ref "soft"
    end
    option[opengl]:
        name = Hardware (OpenGL)
        RENDERER_OVERRIDE = set vid_ref "gl"
    end
end

//
// resolution configuration
//
config[resolution]:
    title = Resolution Configuration
    option[320x240]:
        name = 320×240
        VIDEO_OVERRIDE = set sw_mode "0"$(CRLF)set gl_mode "0"
    end
    option[400x300]:
        name = 400×300
        VIDEO_OVERRIDE = set sw_mode "1"$(CRLF)set gl_mode "1"
    end
    option[512x384]:
        name = 512×384
        VIDEO_OVERRIDE = set sw_mode "2"$(CRLF)set gl_mode "2"
    end
    option[640x480]:
        name = 640×480; priority = 1
        VIDEO_OVERRIDE = set sw_mode "3"$(CRLF)set gl_mode "3"
    end
    option[800x600]:
        name = 800×600
        VIDEO_OVERRIDE = set sw_mode "4"$(CRLF)set gl_mode "4"
    end
    option[960x720]:
        name = 960×720
        VIDEO_OVERRIDE = set sw_mode "5"$(CRLF)set gl_mode "5"
    end
    option[1024x768]:
        name = 1024×768
        VIDEO_OVERRIDE = set sw_mode "6"$(CRLF)set gl_mode "6"
    end
    option[1152x864]:
        name = 1152×864
        VIDEO_OVERRIDE = set sw_mode "7"$(CRLF)set gl_mode "7"
    end
    option[1280x960]:
        name = 1280×960
        VIDEO_OVERRIDE = set sw_mode "8"$(CRLF)set gl_mode "8"
    end
    option[1600x1200]:
        name = 1600×1200
        VIDEO_OVERRIDE = set sw_mode "9"$(CRLF)set gl_mode "9"
    end
end

//
// sound quality configuration
//
config[sound]:
    title = Sound Quality Configuration
    option[low]:
        name = Low
        SOUND_OVERRIDE = [[[$(CRLF)
            set s_khz "11"
            set s_loadas8bit "1"
        ]]]
    end
    option[high]:
        name = High; priority = 1
        SOUND_OVERRIDE = [[[$(CRLF)
            set s_khz "22"
            set s_loadas8bit "0"
        ]]]
    end
end

CFG = [[[$(CRLF)
bind 1 "use Fists"
bind 2 "use Magnum"
bind 3 "use Shotgun"
bind 4 "use AssaultRifle"
bind 5 "use Chaingun"
bind 6 "use SpiderMine"
bind 7 "use RocketLauncher"
bind 8 "use PulseRifle"
bind 9 "use QuantumDestabilizer"
bind 0 "use SniperRifle"

alias toggleviewmode "cmd toggleviewmode"

set developer 0



]]]

script[init]:
    code = [[[$(CRLF)
        if (is_game())
          file_save("$$(rootpath)\\base\\autoexec.cfg", "$$(CFG)");
    ]]]
end

//
// filesystem
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)     ; writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

