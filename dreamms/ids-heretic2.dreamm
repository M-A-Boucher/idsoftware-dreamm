//
// Heretic II
//
desc[ids-heretic2]:

name = Heretic II
icon = ids-heretic2.png
machine = pc
osenv = windows
rootpath = C:\
launch = $(rootpath)\Heretic2.exe
mips = $(MIPS_MAX)
winres = 1600x1200
audiohw = gmidi
filter = id software, fps

MODERN_KEYBINDS = [[[$(CRLF)
    bind    1               "use staff"
    bind    2               "use fball"
    bind    3               "use hell"
    bind    4               "use array"
    bind    5               "use rain"
    bind    6               "use fwall"
    bind    7               "use phoen"
    bind    8               "use sphere"
    bind    9               "use mace"

    bind    z               "use powerup"
    bind    x               "use ring"
    bind    c               "use meteor"
    bind    v               "use morph"
    bind    b               "use tele"
    bind 	n		"use lshield"

    bind shift +speed
    bind ctrl +creep
    bind alt +command

    bind_double shift +creep

    bind w +forward
    bind s +back
    bind a +moveleft
    bind d +moveright
    bind q +movedown
    bind e +action
    bind space +moveup

    bind_double e +mlook
    bind_double a +roll_left
    bind_double d +roll_right

    bind_command a weapprev
    bind_command d weapnext
    bind_command 1 "use powerup"
    bind_command 2 "use ring"
    bind_command 3 "use meteor"
    bind_command 4 "use morph"
    bind_command 5 "use tele"
    bind_command 6 "use lshield"


    // Mouse and other stuff...
    bind mouse1 +attack
    bind mouse2 +defend
    bind mouse3 +forward

    bind_command mouse2 +action

    bind PAUSE   "pause"
    bind ESCAPE  "togglemenu"
    bind ~       "toggleconsole"
    bind `       "toggleconsole"
    bind F1      "cmd help"
    bind t       "messagemode"
    bind +       "sizeup"
    bind =       "sizeup"
    bind -       "sizedown"
]]]

//
// controls configuration
//
config[controls]:
    title = Controls Configuration
    option[classic]:
        name = Customize In-Game (No Overrides)
        KEYBIND_OVERRIDE = $(NULL)
    end
    option[mouse]:
        name = Modern Preset (WASD + Mouse)
        KEYBIND_OVERRIDE = $(MODERN_KEYBINDS)
    end
end

//
// renderer configuration
//
config[renderer]:
    title = Renderer Configuration
    option[software]:
        name = Software
        RENDERER_OVERRIDE = set vid_ref "soft"
    end
    option[opengl]:
        name = Hardware (OpenGL)
        RENDERER_OVERRIDE = set vid_ref "gl"
    end
end

//
// resolution configuration
//
config[resolution]:
    title = Resolution Configuration
    option[320x240]:
        name = 320x240
        VIDEO_OVERRIDE = set vid_mode "0"
    end
    option[400x300]:
        name = 400x300
        VIDEO_OVERRIDE = set vid_mode "1"
    end
    option[512x384]:
        name = 512x384
        VIDEO_OVERRIDE = set vid_mode "2"
    end
    option[640x480]:
        name = 640x480; priority = 1
        VIDEO_OVERRIDE = set vid_mode "3"
    end
    option[800x600]:
        name = 800x600
        VIDEO_OVERRIDE = vid_mode "4"
    end
    option[960x720]:
        name = 960x720
        VIDEO_OVERRIDE = vid_mode "5"
    end
    option[1024x768]:
        name = 1024x768
        VIDEO_OVERRIDE = vid_mode "6"
    end
    option[1152x864]:
        name = 1152x864
        VIDEO_OVERRIDE = vid_mode "7"
    end
    option[1280x960]:
        name = 1280x960
        VIDEO_OVERRIDE = vid_mode "8"
    end
    option[1600x1200]:
        name = 1600x1200
        VIDEO_OVERRIDE = vid_mode "9"
    end
end

//
// sound quality configuration
//
config[sound]:
    title = Sound Quality Configuration
    option[low]:
        name = Low
        SOUND_OVERRIDE = [[[$(CRLF)
            set s_khz "11"
            set s_loadas8bit "1"
        ]]]
    end
    option[high]:
        name = High; priority = 1
        SOUND_OVERRIDE = [[[$(CRLF)
            set s_khz "22"
            set s_loadas8bit "0"
        ]]]
    end
end

CFG = [[[$(CRLF)
    $(KEYBIND_OVERRIDE)
    $(RENDERER_OVERRIDE)
    $(VIDEO_OVERRIDE)
    $(SOUND_OVERRIDE)
    set vid_fullscreen "1"
]]]

script[init]:
    code = [[[$(CRLF)
        if (is_game())
          drive_set_label("D", "HERETIC_II");

          file_save("$$(rootpath)\\base\\autoexec.cfg", "$$(CFG)");
    ]]]
end

//
// filesystem
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)     ; writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\        ; srcpath = $(ifsinstallpath)\CD

