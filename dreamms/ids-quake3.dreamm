//
// Quake III Arena
//
desc[ids-quake3]:

name = Quake III Arena
icon = ids-quake3.png
machine = pc
osenv = windows
rootpath = C:\
launch = $(rootpath)\quake3.exe
mips = $(MIPS_MAX)
winres = 1600x1200x32
audiohw = gmidi
filter = id software, fps

CFG = [[[$(CRLF)
    // generated by quake, do not modify
    unbindall
    bind TAB "+scores"
    bind ENTER "+button2"
    bind ESCAPE "togglemenu"
    bind SPACE "+moveup"
    bind + "sizeup"
    bind - "sizedown"
    bind / "weapnext"
    bind 0 "weapon 10"
    bind 1 "weapon 1"
    bind 2 "weapon 2"
    bind 3 "weapon 3"
    bind 4 "weapon 4"
    bind 5 "weapon 5"
    bind 6 "weapon 6"
    bind 7 "weapon 7"
    bind 8 "weapon 8"
    bind 9 "weapon 9"
    bind = "sizeup"
    bind [ "weapprev"
    bind \ "+mlook"
    bind ] "weapnext"
    bind _ "sizedown"
    bind ` "toggleconsole"
    bind a "+moveleft"
    bind c "+movedown"
    bind d "+moveright"
    bind s "+back"
    bind t "messagemode"
    bind w "+forward"
    bind ~ "toggleconsole"
    bind PAUSE "pause"
    bind UPARROW "+forward"
    bind DOWNARROW "+back"
    bind LEFTARROW "+left"
    bind RIGHTARROW "+right"
    bind ALT "+strafe"
    bind CTRL "+attack"
    bind SHIFT "+speed"
    bind DEL "+lookdown"
    bind PGDN "+lookup"
    bind END "centerview"
    bind F1 "vote yes"
    bind F2 "vote no"
    bind F3 "ui_teamorders"
    bind F11 "screenshot"
    bind MOUSE1 "+attack"
    bind MOUSE2 "+strafe"
    bind MOUSE3 "+zoom"
    bind MWHEELDOWN "weapnext"
    bind MWHEELUP "weapprev"
    seta net_socksPassword ""
    seta net_socksUsername ""
    seta net_socksPort "1080"
    seta net_socksServer ""
    seta net_socksEnabled "0"
    seta net_noipx "0"
    seta net_noudp "0"
    seta cg_viewsize "100"
    seta cg_predictItems "1"
    seta sex "male"
    seta handicap "100"
    seta color "4"
    seta model "sarge"
    seta snaps "20"
    seta rate "3000"
    seta name "UnnamedPlayer"
    seta cl_maxPing "800"
    seta m_filter "0"
    seta m_side "0.25"
    seta m_forward "0.25"
    seta m_yaw "0.022"
    seta m_pitch "0.022"
    seta cg_autoswitch "1"
    seta cl_mouseAccel "0"
    seta sensitivity "5"
    seta cl_run "1"
    seta cl_packetdup "1"
    seta cl_maxpackets "30"
    seta cl_pitchspeed "140"
    seta cl_yawspeed "140"
    seta cl_cdkey "123456789"
    seta sv_master5 ""
    seta sv_master4 ""
    seta sv_master3 ""
    seta sv_master2 ""
    seta sv_floodProtect "1"
    seta sv_maxRate "0"
    seta sv_hostname "noname"
    seta vm_ui "0"
    seta vm_game "0"
    seta vm_cgame "0"
    seta joy_threshold "0.15"
    seta in_joyBallScale "0.02"
    seta in_joystick "0"
    seta in_mouse "1"
    seta in_mididevice "0"
    seta in_midichannel "1"
    seta in_midiport "1"
    seta in_midi "0"
    seta com_introplayed "1"
    seta com_blood "1"
    seta com_maxfps "85"
    seta com_hunkMegs "56"
]]]

script[init]:
    code = file_save("$$(rootpath)\\baseq3\\q3config.cfg", "$$(CFG)")
end

//
// filesystem
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)  ; writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// v1.11
//
game[v1.11]:
    name = v1.11
    anchorfile = quake3.exe
    anchordepth = 2
    file[]: crc = 91bc722a; size =    864313; name = quake3.exe
    file[]: crc = c6554342; size = 479493658; name = baseq3\pak0.pk3
    file[]: crc = 1c615563; size =     10782; name = baseq3\pak1.pk3
end

//
// v1.30
//
game[v1.30]:
    name = v1.30
    imports = v1.11
    file[]: crc = 2cd453d7; size =    876544; name = quake3.exe
    file[]: crc = 6181a134; size =    374405; name = baseq3\pak1.pk3
    file[]: crc = 7fad00a1; size =   7511182; name = baseq3\pak2.pk3
    file[]: crc = 28ab3fc4; size =    276305; name = baseq3\pak3.pk3
    file[]: crc = f5327c65; size =   9600350; name = baseq3\pak4.pk3
    file[]: crc = 2331ccda; size =    191872; name = baseq3\pak5.pk3
    file[]: crc = 0dce205d; size =   7346884; name = baseq3\pak6.pk3
end

//
// v1.32
//
game[v1.32]:
    name = v1.32
    imports = v1.30
    file[]: crc = 795ba53c; size =    905216; name = quake3.exe
    file[]: crc = da616bca; size =    320873; name = baseq3\pak7.pk3
    file[]: crc = 08215426; size =    454478; name = baseq3\pak8.pk3
end

end
