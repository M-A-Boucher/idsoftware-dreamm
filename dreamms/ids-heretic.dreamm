//
// Heretic
//
desc[ids-heretic]:

name = Heretic
icon = ids-heretic.png
machine = pc
osenv = dos
rootpath = C:\
launch = $(rootpath)\HERETIC.EXE -config DREAMM.CFG
mips = $(MIPS_486DX4_100)
ramkb = 8192
filter = id software, fps
audiohw = $(SOUNDHW)+$(MUSICHW)
videohw = vga

//
//
//
config[keyboard]:
    title = Keyboard Setup
    option[default]:
        name = Original (Arrow Keys)
        CONTROLS_CONFIG = [[[$(CRLF)
            key_right           77
            key_left            75
            key_up              72
            key_down            80
            key_strafeleft      51
            key_straferight     52
        ]]]
    end
    option[wasd]:
        name = Modern (WASD Keys)
        CONTROLS_CONFIG = [[[$(CRLF)
            key_right           32
            key_left            30
            key_up              17
            key_down		31
            key_strafeleft      16
            key_straferight     18
        ]]]
    end
end

//
// music configuration
//
config[music]:
    title = Music Configuration

    option[adlib]:
        name = $(ADLIB_NAME)
        MUSICHW = adlib
        MUSIC = 2
    end
    option[sb16]:
        name = $(SB16_NAME); priority = 1
        MUSICHW = sb16
        MUSIC = 3
    end
    option[gmidi]:
        name = $(GMIDI_NAME)
        MUSICHW = gmidi
        MUSIC = 8
    end
end

//
// sound configuration
//
config[sound]:
    title = Sound Configuration
    option[speaker]:
        name = $(SPEAKER_NAME)
        SOUNDHW = speaker
        SOUND = 1
    end
    option[sb16]:
        name = $(SB16_NAME); priority = 1
        SOUNDHW = sb16
        SOUND = 3
    end
end

dynamicfile[]:
    path = $(rootpath)/DREAMM.CFG
    contents = [[[$(CRLF)
        mouse_sensitivity	10
        sfx_volume		8
        music_volume		8
        show_messages		1
        $(CONTROLS_CONFIG)
        key_fire		29
        key_use		        57
        key_strafe		56
        key_speed		54
        use_mouse		1
        mouseb_fire		0
        mouseb_strafe		1
        mouseb_forward		2
        use_joystick		1
        joyb_fire		0
        joyb_strafe		1
        joyb_use		3
        joyb_speed		2
        screenblocks		10
        detaillevel		0
        showmessages		1
        snd_channels		8
        snd_musicdevice		$(MUSIC)
        snd_sfxdevice		$(SOUND)
        snd_sbport		544
        snd_sbirq		7
        snd_sbdma		1
        snd_mport		816
        usegamma		0
        chatmacro0		"no macro"
        chatmacro1		"no macro"
        chatmacro2		"no macro"
        chatmacro3		"no macro"
        chatmacro4		"no macro"
        chatmacro5		"no macro"
        chatmacro6		"no macro"
        chatmacro7		"no macro"
        chatmacro8		"no macro"
        chatmacro9		"no macro"
		0
    ]]]
end

dynamicfile[]:
    path = $(rootpath)\DREAMM10.BAT
    contents = [[[$(CRLF)
        COPY HREG_V10.1+HREG_V10.2+HREG_V10.3+HREG_V10.4+HREG_V10.5 HREG_V10.EXE
        HREG_V10.EXE
    ]]]
end


//
// filesystem
//
mount[]: vpath = C:\;         srcpath = $(ifsdeltapath); writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath);

//
// v1.0
//
game[v1.0]:
    name = v1.0
    anchorfile = HERETIC.WAD
    file[]: crc = 5d56f9d6; size =     33678; name = DM.EXE      ; optional = true
    file[]: crc = e272977c; size =      6397; name = DM.TXT      ; optional = true
    file[]: crc = ffa4a9af; size =     65021; name = DWANGO.EXE  ; optional = true
    file[]: crc = 9429e073; size =      2536; name = DWANGO.STR  ; optional = true
    file[]: crc = 039525a3; size =     10623; name = DWANGO.TXT  ; optional = true
    file[]: crc = 499749d7; size =    717239; name = HERETIC.EXE
    file[]: crc = 77482d1e; size =  11096488; name = HERETIC.WAD
    file[]: crc = c4cd13b0; size =     17971; name = IPXSETUP.EXE; optional = true
    file[]: crc = d31b3e59; size =        50; name = MODEM.CFG   ; optional = true
    file[]: crc = b5d192a9; size =        33; name = MODEM.NUM   ; optional = true
    file[]: crc = 8a8dd2ec; size =      3048; name = MODEM.STR   ; optional = true
    file[]: crc = 9dbb9b52; size =     20257; name = SERSETUP.EXE; optional = true
    file[]: crc = bb2a8640; size =     47094; name = SETUP.EXE   ; optional = true
end

//
// v1.0, CD, Installer
//
installer[v1.0-cd-installer]:
    name = v1.0, CD, Installer
    installid = v1.0
    mips = $(MIPS_MAX)
    launch = DREAMM10.BAT
    anchorfile = HREG_V10.4
    file[]: crc = 106fef98; size =   1439232; name = HREG_V10.1
    file[]: crc = e6fc9905; size =   1457664; name = HREG_V10.2
    file[]: crc = c18b8fac; size =   1457664; name = HREG_V10.3
    file[]: crc = 38f9a52b; size =   1444781; name = HREG_V10.4
end

end