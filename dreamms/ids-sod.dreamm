//
// Spear of Destiny
//
desc[ids-sod]:

name = Spear of Destiny
icon = ids-sod.png
machine = pc
osenv = dos
rootpath = C:\
launch = SPEAR.EXE
mips = $(MIPS_386DX_33)
ramkb = 8192
filter = id software, action
videohw = vga
drivetypes = FFH[256MB/128MB]C

//
// sound configuration
//
config[sound]:
    title = Sound Configuration
    option[speaker]:
        name = $(SPEAKER_NAME)
        audiohw = speaker
    end
    option[adlib]:
        name = $(ADLIB_NAME)
        audiohw = adlib
    end
    option[sb16]:
        name = $(SB16_NAME); priority = 1
        audiohw = sb16
    end
end

//
// filesystem
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath); writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = A:\        ; srcpath = $(ifsinstallpath)\DISK1; optional = true; disc = 1
mount[]: vpath = A:\        ; srcpath = $(ifsinstallpath)\DISK2; optional = true; disc = 2
mount[]: vpath = A:\        ; srcpath = $(ifsinstallpath)\DISK3; optional = true; disc = 3

dynamicfile[]: path = A:\SPEAR 1; attributes = 8; disc = 1
dynamicfile[]: path = A:\SPEAR 2; attributes = 8; disc = 2
dynamicfile[]: path = A:\SPEAR 3; attributes = 8; disc = 3

script[autoinstall]:
    condition = is_installer()
    code = [[[$(CRLF)
       keyboard_type("C");
       keyboard_type("\r");
       keyboard_type("\r");
       wait("int16", 0x00); disc_insert(2); keyboard_type("\r");
       wait("int16", 0x00); disc_insert(3); keyboard_type("\r");
    ]]]
end

//
// copy protection script
//
$(include cp-sod.inc)

//
// v1.0, 3x720K
//
game[v1.0-3x720k]:
    name = v1.0, 3x720K
    anchorfile = SPEAR.EXE
    file[]: crc = 13ce3958; size =      1072; name = AUDIOHED.SOD
    file[]: crc = 96d183ec; size =    328620; name = AUDIOT.SOD
    file[]: crc = b564a0be; size =     68290; name = GAMEMAPS.SOD
    file[]: crc = cdb40ca8; size =       402; name = MAPHEAD.SOD
    file[]: crc = beebc1f9; size =    113273; name = SPEAR.EXE
    file[]: crc = b9b960ac; size =      1024; name = VGADICT.SOD
    file[]: crc = 5936dddb; size =    947979; name = VGAGRAPH.SOD
    file[]: crc = dfb1b473; size =       510; name = VGAHEAD.SOD
    file[]: crc = 591cc4dc; size =   1616544; name = VSWAP.SOD
end

//
// v1.0, 3x720K, Installer
//
installer[v1.0-3x720k-installer]:
    name = v1.0, 3x720K, Installer
    installid = v1.0-3x720k
    mips = $(MIPS_MAX)
    rootpath = A:\
    launch = $(rootpath)\INSTALL.EXE
    anchorfile = INSTALL.EXE
    file[]: crc = f42d8dd3; size =     15456; name = DISK1\INSTALL.EXE
    file[]: crc = 0d0ae5ca; size =     39283; name = DISK1\INSTALL.OVL
    file[]: crc = d05e96ea; size =    113325; name = DISK1\SOD.1
    file[]: crc = 7342d2a4; size =       681; name = DISK1\SOD.2
    file[]: crc = 463c3511; size =    149182; name = DISK1\SOD.3
    file[]: crc = a25abd84; size =     51514; name = DISK1\SOD.4
    file[]: crc = 2b268606; size =       139; name = DISK1\SOD.5
    file[]: crc = a8dd9f20; size =      1060; name = DISK1\SOD.6
    file[]: crc = 9d38c5b1; size =    354304; name = DISK1\SOD.7; exactonly = true
    file[]: crc = ba5bcd0a; size =    505600; name = DISK2\SOD.7; exactonly = true
    file[]: crc = ca4bd5a8; size =       546; name = DISK2\SOD.8
