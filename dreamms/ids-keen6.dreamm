//
// Commander Keen in “Aliens Ate My Babysitter!”
//
desc[ids-keen6]:

name = Commander Keen in “Aliens Ate My Babysitter!”
icon = ids-keen6.png
machine = pc
osenv = dos
rootpath = C:\
launch = KEEN6.EXE
mips = $(MIPS_386SX_20)
ramkb = 8192
filter = id software, action
audiohw = sb16

//
// graphics configuration
//
config[graphics]:
    title = Graphics Configuration
    option[cga]:
        name = $(CGA_NAME)
        videohw = cga; priority = 2
        condition = file_exists("$$(rootpath)\\CGAGRAPH.CK6")
    end
    option[ega]:
        name = $(EGA_NAME); priority = 1
        videohw = ega
    end
    option[vga]:
        name = $(VGA_NAME)
        videohw = vga
    end
end

INSTALL_CGA = [[[$(CRLF)
    CK6-1C.EXE
    CK6-2C.EXE
    CK6-3.EXE
    CK6-4.EXE
]]]

INSTALL_VGA = [[[$(CRLF)
    CK6-1V.EXE
    CK6-2V.EXE
    CK6-3.EXE
    CK6-4.EXE
]]]

//
// filesystem
//
mount[]: vpath = C:\;         srcpath = $(ifsdeltapath); writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath);

script[init]:
    code = [[[$(CRLF)
        if (is_installer())
        {
          file_save("$$(rootpath)\\DREAMMC.BAT", "$$(INSTALL_CGA)");
          file_save("$$(rootpath)\\DREAMMV.BAT", "$$(INSTALL_VGA)");
        }

        if (is_game())
        {
          if (file_exists("$$(rootpath)\\CONFIG.CK6"))
          {
            file = file_load_blob("CONFIG.CK6");
            blob_fill(file, 0x21e, 1, "`h:01");
          }
          else
          {
            file = blob_create("HEX:43 4B 36 00 04 00 49 64 20 53 6F 66 74 77 61 72 65 20 2D 20 27 39 31 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 10 27 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 10 27 00 00 00 00 4A 61 73 6F 6E 20 42 6C 6F 63 68 6F 77 69 61 6B 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 10 27 00 00 00 00 41 64 72 69 61 6E 20 43 61 72 6D 61 63 6B 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 10 27 00 00 00 00 4A 6F 68 6E 20 43 61 72 6D 61 63 6B 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 10 27 00 00 00 00 54 6F 6D 20 48 61 6C 6C 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 10 27 00 00 00 00 4A 6F 68 6E 20 52 6F 6D 65 72 6F 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 10 27 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 10 27 00 00 00 00 02 00 01 00 00 00 1D 38 47 48 49 4B 4D 4F 50 51 01 00 00 00 00 00 01 00 01 00 00 00 39 00 00 00 00 00 00 00 00 00 00");
          }
        
          file_save("CONFIG.CK6", file);
        }
    ]]]
end

//
// copy protection script
//
$(include cp-keen6.inc)

//
// v1.0, CGA
//
game[v1.0-cga]:
    name = v1.0, CGA
    anchorfile = KEEN6.EXE
    file[]: crc = 472e62f3; size =     56265; name = AUDIO.CK6
    file[]: crc = 39d32d6e; size =    311897; name = CGAGRAPH.CK6
    file[]: crc = 40f298f8; size =     95421; name = GAMEMAPS.CK6
    file[]: crc = a392f517; size =     98614; name = KEEN6.EXE
end

//
// v1.0, 2x720K, CGA, Installer
//
installer[v1.0-2x720k-cga-installer]:
    name = v1.0, 2x720K, CGA, Installer
    installid = v1.0-cga
    mips = $(MIPS_MAX)
    launch = DREAMMC.BAT
    anchorfile = CK6-1C.EXE
    file[]: crc = ccd2ba6e; size =     93832; name = CK6-1C.EXE
    file[]: crc = c18edbe7; size =    204122; name = CK6-2C.EXE
    file[]: crc = 741c7a78; size =     69092; name = CK6-3.EXE
    file[]: crc = bbc31457; size =     46935; name = CK6-4.EXE
end

