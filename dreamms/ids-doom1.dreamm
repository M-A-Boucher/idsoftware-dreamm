//
// Doom
//
desc[ids-doom1]:

name = Doom
icon = ids-doom1.png
machine = pc
osenv = dos
rootpath = C:\
launch = $(rootpath)\DOOM.EXE -config DREAMM.CFG
mips = $(MIPS_486DX4_100)
ramkb = 8192
filter = id software, fps
audiohw = $(SOUNDHW)+$(MUSICHW)
videohw = vga

//
//
//
config[keyboard]:
    title = Keyboard Setup
    option[default]:
        name = Original (Arrow Keys)
        KEYBINDS = [[[$(CRLF)
            key_right           77
            key_left            75
            key_up              72
            key_down            80
            key_strafeleft      51
            key_straferight     52
            use_mouse		0
        ]]]
    end
    option[wasd]:
        name = Modern (WASD Keys)
        KEYBINDS = [[[$(CRLF)
            key_left            16
            key_right           18
            key_up              17
            key_down		31
            key_strafeleft      30 
            key_straferight     32 
            use_mouse		1
        ]]]
    end
end

//
// music configuration
//
config[music]:
    title = Music Configuration

    option[adlib]:
        name = $(ADLIB_NAME)
        MUSICHW = adlib
        MUSIC = 2
    end
    option[sb16]:
        name = $(SB16_NAME); priority = 1
        MUSICHW = sb16
        MUSIC = 3
    end
    option[gmidi]:
        name = $(GMIDI_NAME)
        MUSICHW = gmidi
        MUSIC = 8
    end
end

//
// sound configuration
//
config[sound]:
    title = Sound Configuration
    option[speaker]:
        name = $(SPEAKER_NAME)
        SOUNDHW = speaker
        SOUND = 1
    end
    option[sb16]:
        name = $(SB16_NAME); priority = 1
        SOUNDHW = sb16
        SOUND = 3
    end
end

CONFIG = [[[$(CRLF)
        mouse_sensitivity	10
        sfx_volume		8
        music_volume		8
        show_messages		1
        key_fire		29
        key_use		        57
        key_strafe		56
        key_speed		54
        mouseb_fire		0
        mouseb_strafe		1
        mouseb_forward		2
        use_joystick		1
        joyb_fire		0
        joyb_strafe		1
        joyb_use		3
        joyb_speed		2
        screenblocks		10
        detaillevel		0
        showmessages		1
        snd_channels		4
        snd_sbport		544
        snd_sbirq		7
        snd_sbdma		1
        snd_mport		544
        usegamma		0
        chatmacro0		"no macro"
        chatmacro1		"no macro"
        chatmacro2		"no macro"
        chatmacro3		"no macro"
        chatmacro4		"no macro"
        chatmacro5		"no macro"
        chatmacro6		"no macro"
        chatmacro7		"no macro"
        chatmacro8		"no macro"
        chatmacro9		"no macro"
        snd_musicdevice		$(MUSIC)
        snd_sfxdevice		$(SOUND)
        $(KEYBINDS)
]]]


script[autoconfig]:
    code = [[[$(CRLF)
        file = "$$(rootpath)\\DREAMM.CFG";

        if (file_exists(file))
        {
          content = file_load_string(file);
          content = substr(content, 0, strstr(content, "snd_musicdevice"));
          content = content + "snd_musicdevice $$(MUSIC)$$(CRLF)snd_sfxdevice $$(SOUND)$(CRLF)$$(KEYBINDS)";
        }
        else
        {
          content = "$$(CONFIG)";
        }

        file_save(file, content);
    ]]]
end
          
dynamicfile[]:
    path = $(rootpath)\DREAMM1R.BAT
    contents = [[[$(CRLF)
        COPY DOOM1_1R.1+DOOM1_1R.2+DOOM1_1R.3+DOOM1_1R.4 DOOM1_1R.EXE
        DOOM1_1R.EXE
    ]]]
end

dynamicfile[]:
    path = $(rootpath)\DREAMM2R.BAT
    contents = [[[$(CRLF)
        COPY DOOM1_2R.1+DOOM1_2R.2+DOOM1_1R.3+DOOM1_2R.4 DOOM1_2R.EXE
        DOOM1_2R.EXE
    ]]]
end

dynamicfile[]:
    path = $(rootpath)\DREAMM6R.BAT
    contents = [[[$(CRLF)
        COPY DOOM166R.1+DOOM166R.2+DOOM166R.3+DOOM166R.4 DOOM166R.EXE
        DOOM166R.EXE
    ]]]
end

dynamicfile[]:
    path = $(rootpath)\DREAMM9R.BAT
    contents = [[[$(CRLF)
        COPY DOOMR_19.1+DOOMR_19.2+DOOMR_19.3+DOOMR_19.4 DOOMR_19.EXE
        DOOMR_19.EXE
    ]]]
end

dynamicfile[]:
    path = $(rootpath)\DREAMM9D.BAT
    contents = [[[$(CRLF)
        COPY DOOMS_19.1+DOOMS_19.2 DOOMS_19.EXE
        DOOMS_19.EXE
    ]]]
end

dynamicfile[]:
    path = $(rootpath)\DREAMMSE.BAT
    contents = [[[$(CRLF)
        COPY DOOM_SE.1+DOOM_SE.2+DOOM_SE.3+DOOM_SE.4 DOOM_SE.EXE
        DOOM_SE.EXE
    ]]]
end

//
// filesystem
//
mount[]: vpath = C:\;         srcpath = $(ifsdeltapath); writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath);

//
// v1.1
//
game[v1.1]:
    name = v1.1
    anchorfile = DOOM.EXE
    file[]: crc = 2529c9a1; size =    579187; name = DOOM.EXE
    file[]: crc = 66457ab9; size =  10396254; name = DOOM.WAD
    file[]: crc = 65bdd009; size =       439; name = FILE_ID.DIZ ; optional = true
    file[]: crc = 95491c54; size =     68923; name = SETUP.EXE   ; optional = true
end

//
// v1.1, 4x1.44M, Installer
//
installer[v1.1-4x1.44m-installer]:
    name = v1.1, 4x1.44M, Installer
    installid = v1.1
    mips = $(MIPS_MAX)
    launch = DREAMM1R.BAT
    anchorfile = DOOM1_1R.4
    file[]: crc = ced87853; size =   1439232; name = DOOM1_1R.1
    file[]: crc = 7f0292d2; size =   1457664; name = DOOM1_1R.2
    file[]: crc = ec56b39e; size =   1457664; name = DOOM1_1R.3
    file[]: crc = 765c6658; size =    949445; name = DOOM1_1R.4
end

