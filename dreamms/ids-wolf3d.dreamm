//
// Wolfenstein 3D
//
desc[ids-wolf3d]:

name = Wolfenstein 3D
icon = ids-wolf3d.png
machine = pc
osenv = dos
rootpath = C:\
launch = WOLF3D.EXE
mips = $(MIPS_386DX_33)
ramkb = 8192
filter = id software, action
videohw = vga

//
// sound configuration
//
config[sound]:
    title = Sound Configuration
    option[speaker]:
        name = $(SPEAKER_NAME)
        audiohw = speaker
    end
    option[adlib]:
        name = $(ADLIB_NAME); priority = 1
        audiohw = adlib
    end
    option[sb16]:
        name = $(SB16_NAME)
        audiohw = sb16
    end
end

dynamicfile[]:
    path = $(rootpath)\DREAMM.BAT
    contents = [[[$(CRLF)
        COPY WOLF1-6.1+WOLF1-6.2 WOLF1-6.EXE
        WOLF1-6.EXE -Y
    ]]]
end

dynamicfile[]:
    path = $(rootpath)\DREAMMGT.BAT
    contents = [[[$(CRLF)
        COPY W3DGT.1+W3DGT.2+W3DGT.3+W3DGT.4 W3DGT.EXE
        W3DGT.EXE
    ]]]
end

//
// filesystem
//
mount[]: vpath = C:\;         srcpath = $(ifsdeltapath); writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath);

script[autoinstall]:
    condition = is_installer() && file_exists("$$(rootpath)\\W3D_1-6._1")
    code = [[[$(CRLF)
        input_lockout(true);
        wait("int16", 0x00); keyboard_type("\r");
        wait("int16", 0x00); keyboard_type("C");
        wait("int16", 0x00); keyboard_type("N");
        input_lockout(false);
    ]]]
end

//
// v1.2 
//
game[v1.2]:
    name = v1.2
    anchorfile = WOLF3D.EXE
    file[]: crc = 056ac3db; size =      1156; name = AUDIOHED.WL6
    file[]: crc = 1585d305; size =    317049; name = AUDIOT.WL6
    file[]: crc = 1029c727; size =    150758; name = GAMEMAPS.WL6
    file[]: crc = 5e43caee; size =       402; name = MAPHEAD.WL6
    file[]: crc = 28687d1a; size =      1024; name = VGADICT.WL6
    file[]: crc = e1d6765f; size =    302374; name = VGAGRAPH.WL6
    file[]: crc = 53b4b582; size =       477; name = VGAHEAD.WL6
    file[]: crc = 97fe030d; size =   1545400; name = VSWAP.WL6
    file[]: crc = eeb3decc; size =     98402; name = WOLF3D.EXE
end

//
// v1.2, 1x1.44M, Installer
//
installer[v1.2-1x1.44m-installer]:
    name = v1.2, 1x1.44M, Installer
    installid = v1.2
    mips = $(MIPS_MAX)
    launch = WOLF1-6.EXE -Y
    anchorfile = WOLF1-6.1
    file[]: crc = 9aad0c46; size =   1149147; name = WOLF1-6.EXE
end

