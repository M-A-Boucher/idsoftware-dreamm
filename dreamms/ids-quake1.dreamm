//
// Quake
//
desc[ids-quake1]:

name = Quake
icon = ids-quake1.png
machine = pc
osenv = dos
rootpath = C:\
mips = $(MIPS_MAX)
ramkb = 16384
filter = id software, fps
videohw = svga
audiohw = sb16
HIPNOTIC = 0
ROGUE = 0

//
// renderer configuration
//
config[renderer]:
    title = Renderer Configuration
    condition = !is_installer() && is_windows()
    option[winquake]:
        name = Software
        condition = file_exists("$$(rootpath)\\WINQUAKE.EXE")
        launch = $(rootpath)\WINQUAKE.EXE
    end
     option[glquake]:
        name = Hardware (OpenGL)
        condition = file_exists("$$(rootpath)\\GLQUAKE.EXE")
        launch = $(rootpath)\GLQUAKE.EXE
    end   
end

//
// game configuration
//
config[game]:
    title = Game Configuration
    condition = !is_installer() && is_dos()
    option[quake]:
        name = Quake
        condition = file_exists("$$(rootpath)\\QUAKE.EXE") && file_exists("$$(rootpath)\\ID1\\PAK0.PAK")
        launch = QUAKE.EXE
    end
    option[hipnotic]:
        name = Scourge of Armagon
        condition = file_exists("$$(rootpath)\\QUAKE.EXE") && file_exists("$$(rootpath)\\HIPNOTIC\\PAK0.PAK")
        launch = QUAKE.EXE -game hipnotic -hipnoticpnotic
        HIPNOTIC = 1
    end
    option[rogue]:
        name = Dissolution of Eternity
        condition = file_exists("$$(rootpath)\\QUAKE.EXE") && file_exists("$$(rootpath)\\ROGUE\\PAK0.PAK")
        launch = ROGUE\QUAKE.EXE -rogue
        ROGUE = 1
    end
end

//
// controls configuration
//
config[controls]:
    title = Controls Configuration
    option[classic]:
        name = Classic (Default Quake)
        KEYBIND_OVERRIDE = $(NULL)
    end
    option[inverted]:
        name = Modern (WASD + Mouse)
        KEYBIND_OVERRIDE = [[[$(CRLF)
            bind "w" "+forward"
            bind "a" "+moveleft"
            bind "s" "+back"
            bind "d" "+moveright"
            +mlook
            m_pitch "0.022000"
            sensitivity "6"
        ]]]
    end
    option[mouse]:
        name = Modern (WASD + Inverted Mouse)
        KEYBIND_OVERRIDE = [[[$(CRLF)
            bind "w" "+forward"
            bind "a" "+moveleft"
            bind "s" "+back"
            bind "d" "+moveright"
            +mlook
            m_pitch "-0.022000"
            sensitivity "6"
        ]]]
    end
end

//
// graphics configuration
//
config[graphics]:
    title = Graphics Configuration
    option[320x200]:
        name = 320x200
        VIDEO_OVERRIDE = vid_mode 0
    end
    option[320x240]:
        name = 320x240
        VIDEO_OVERRIDE = vid_mode 3
    end
    option[360x350]:
        name = 360x350
        VIDEO_OVERRIDE = vid_mode 6
    end
    option[360x400]:
        name = 360x400
        VIDEO_OVERRIDE = vid_mode 8
    end
    option[640x400]:
        name = 640x400
        VIDEO_OVERRIDE = vid_mode 11
    end
    option[640x480]:
        name = 640x480
        priority = 1
        VIDEO_OVERRIDE = vid_mode 12
    end
    option[800x600]:
        name = 800x600
        VIDEO_OVERRIDE = vid_mode 13
    end
    option[1024x768]:
        name = 1024x768
        VIDEO_OVERRIDE = vid_mode 14
    end
    option[1280x1024]:
        name = 1280x1024
        VIDEO_OVERRIDE = vid_mode 15
    end
end

INSTALL = [[[$(CRLF)
    COPY QUAKE101.1+QUAKE101.2 QUAKE101.EXE
    QUAKE101.EXE
]]]

INSTALL_106 = [[[$(CRLF)
    REN RESOURCE.1 RESOURCE.EXE
    RESOURCE.EXE
]]]

INSTALL_SW = [[[$(CRLF)
    COPY QSW101.1+QSW101.2+QSW101.3+QSW101.4+QSW101.5+QSW101.6+QSW101.7 QSW101.EXE
    QSW101.EXE
]]]

CFG = [[[$(CRLF)
    $(KEYBIND_OVERRIDE)
    $(VIDEO_OVERRIDE)
]]]

script[init]:
    code = [[[$(CRLF)
        if (is_installer())
        {
          file_save("$$(rootpath)\\DREAMM.BAT", "$$(INSTALL)");
          file_save("$$(rootpath)\\DREAMMSW.BAT", "$$(INSTALL_106)");
          file_save("$$(rootpath)\\DREAMMSW.BAT", "$$(INSTALL_SW)");
        }

        if (is_game())
          file_save("$$(rootpath)\\ID1\\AUTOEXEC.CFG", "$$(CFG)");
    ]]]
end

//
// filesystem
//
mount[]: vpath = C:\;         srcpath = $(ifsdeltapath); writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\;         srcpath = $(ifsinstallpath)/ID1_CD        ; condition = is_game(); disc = 1
mount[]: vpath = D:\;         srcpath = $(ifsinstallpath)/HIPNOTIC_CD   ; condition = is_game(); disc = 2; optional = true
mount[]: vpath = D:\;         srcpath = $(ifsinstallpath)/ROGUE_CD      ; condition = is_game(); disc = 3; optional = true


script[hipnotic]:
    condition = $(HIPNOTIC)
    code = disc_insert(2);
end

script[rogue]:
    condition = $(ROGUE)
    code = disc_insert(3);
end

//
// v1.01, CD
//
game[v1.01-cd]:
    name = v1.01, CD
    anchorfile = QUAKE.EXE
