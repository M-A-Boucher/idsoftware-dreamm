//
// Anthology, Installer
//
installer[anthology-installer]:
    name = Anthology, Installer
    installid = rover
    mips = $(MIPS_MAX)
    launch = ROVER1.EXE
    anchorfile = ROVER1.EXE
    file[]: crc = a219e4a3; size =    143662; name = ROVER1.EXE
end

end