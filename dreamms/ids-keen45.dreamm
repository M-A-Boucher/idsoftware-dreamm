//
installer[anthology-keen5-installer]:
    name = Anthology, Episode 5, Installer
    installid = v1.4-keen5
    mips = $(MIPS_MAX)
    launch = KEEN5INS.EXE
    anchorfile = KEEN5INS.EXE
    file[]: crc = 00e51033; size =    641949; name = KEEN5INS.EXE
