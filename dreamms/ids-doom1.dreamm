//
// Doom
//
desc[ids-doom1]:

name = Doom
icon = ids-doom1.png
machine = pc
osenv = dos
rootpath = C:\
launch = $(rootpath)\DOOM.EXE -config $(CONFIG_FILE)
mips = $(MIPS_486DX4_100)
ramkb = 8192
filter = id software, fps
videohw = vga

$(include cfg-doom.inc)
   
DREAMM1R = [[[$(CRLF)
    COPY DOOM1_1R.1+DOOM1_1R.2+DOOM1_1R.3+DOOM1_1R.4 DOOM1_1R.EXE
    DOOM1_1R.EXE
]]]

DREAMM2R = [[[$(CRLF)
    COPY DOOM1_2R.1+DOOM1_2R.2+DOOM1_1R.3+DOOM1_2R.4 DOOM1_2R.EXE
    DOOM1_2R.EXE
]]]

DREAMM6R = [[[$(CRLF)
    COPY DOOM166R.1+DOOM166R.2+DOOM166R.3+DOOM166R.4 DOOM166R.EXE
    DOOM166R.EXE
]]]

DREAMM9R = [[[$(CRLF)
    COPY DOOMR_19.1+DOOMR_19.2+DOOMR_19.3+DOOMR_19.4 DOOMR_19.EXE
    DOOMR_19.EXE
]]]

DREAMM9D = [[[$(CRLF)
    COPY DOOMS_19.1+DOOMS_19.2 DOOMS_19.EXE
    DOOMS_19.EXE
]]]

DREAMMSE = [[[$(CRLF)
    COPY DOOM_SE.1+DOOM_SE.2+DOOM_SE.3+DOOM_SE.4 DOOM_SE.EXE
    DOOM_SE.EXE
]]]

script[init]:
    condition = is_installer()
    code = [[[$(CRLF)
        file_save("$$(rootpath)\\DREAMM1R.BAT", "$$(DREAMM1R)");
        file_save("$$(rootpath)\\DREAMM2R.BAT", "$$(DREAMM2R)");
        file_save("$$(rootpath)\\DREAMM6R.BAT", "$$(DREAMM6R)");
        file_save("$$(rootpath)\\DREAMM9R.BAT", "$$(DREAMM9R)");
        file_save("$$(rootpath)\\DREAMM9D.BAT", "$$(DREAMM9D)");
        file_save("$$(rootpath)\\DREAMMSE.BAT", "$$(DREAMMSE)");
    ]]]
end

//
// filesystem
//
mount[]: vpath = C:\;         srcpath = $(ifsdeltapath); writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath);

//
// v1.1
//
game[v1.1]:
    name = v1.1
    anchorfile = DOOM.EXE
    file[]: crc = 2529c9a1; size =    579187; name = DOOM.EXE
    file[]: crc = 66457ab9; size =  10396254; name = DOOM.WAD
    file[]: crc = 65bdd009; size =       439; name = FILE_ID.DIZ ; optional = true
    file[]: crc = 95491c54; size =     68923; name = SETUP.EXE   ; optional = true
end

//
// v1.1, 4x1.44M, Installer
//
installer[v1.1-4x1.44m-installer]:
    name = v1.1, 4x1.44M, Installer
    installid = v1.1
    mips = $(MIPS_MAX)
    launch = DREAMM1R.BAT
    anchorfile = DOOM1_1R.4
    file[]: crc = ced87853; size =   1439232; name = DOOM1_1R.1
    file[]: crc = 7f0292d2; size =   1457664; name = DOOM1_1R.2
    file[]: crc = ec56b39e; size =   1457664; name = DOOM1_1R.3
    file[]: crc = 765c6658; size =    949445; name = DOOM1_1R.4
end

//
// v1.2
//
game[v1.2]:
    name = v1.2
    imports = v1.1
    file[]: crc = 7734c756; size =    580391; name = DOOM.EXE
    file[]: crc = a5da8930; size =  10399316; name = DOOM.WAD
    file[]: crc = 427272dd; size =     32134; name = IPXSETUP.EXE; optional = true
    file[]: crc = caf66956; size =       393; name = MODEM.CFG   ; optional = true
    file[]: crc = 5f1c6289; size =     36567; name = SERSETUP.EXE; optional = true
    file[]: crc = db8b4f8b; size =     91931; name = SETUP.EXE   ; optional = true
end

//
// v1.2, 4x1.44M, Installer
//
installer[v1.2-4x1.44m-installer]:
    name = v1.2, 4x1.44M, Installer
    installid = v1.2
    mips = $(MIPS_MAX)
    launch = DREAMM2R.BAT
    anchorfile = DOOM1_2R.4
    file[]: crc = 40055ce6; size =   1437184; name = DOOM1_2R.1
    file[]: crc = 95038ccc; size =   1457664; name = DOOM1_2R.2
    file[]: crc = 1510ad0f; size =   1457664; name = DOOM1_2R.3
    file[]: crc = 040a1717; size =    694319; name = DOOM1_2R.4
end

