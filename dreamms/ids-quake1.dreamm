//
addon[hipnotic]:
    name = Mission Pack No. 1: Scourge of Armagon
    upgradeids = v1.01-cd, v1.06-cd
    anchorfile = QUAKE.EXE
    file[]: crc = 48119396; size =    409600; name = QUAKE.EXE
    file[]: crc = d17835fb; size =  35527205; name = HIPNOTIC\PAK0.PAK
    file[]:                                   name = HIPNOTIC_CD\CDDA.SOU; cdda = 191/191/184/192/193/192/183/183; optional = true
end

