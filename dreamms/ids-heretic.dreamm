//
// Heretic
//
desc[ids-heretic]:

name = Heretic
icon = ids-heretic.png
machine = pc
osenv = dos
rootpath = C:\
launch = $(rootpath)\HERETIC.EXE -config $(CONFIG_FILE)
mips = $(MIPS_486DX4_100)
ramkb = 8192
filter = id software, fps
videohw = vga

$(include cfg-doom.inc)

INSTALL = [[[$(CRLF)
    COPY HREG_V10.1+HREG_V10.2+HREG_V10.3+HREG_V10.4+HREG_V10.5 HREG_V10.EXE
    HREG_V10.EXE
]]]

script[init]:
    condition = is_installer()
    code = [[[$(CRLF)
        file_save("$$(rootpath)\\DREAMM.BAT", "$$(INSTALL)");
    ]]]
end

//
// filesystem
//
mount[]: vpath = C:\;         srcpath = $(ifsdeltapath); writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath);

//
// v1.0
//
game[v1.0]:
    name = v1.0
    anchorfile = HERETIC.EXE
    file[]: crc = 5d56f9d6; size =     33678; name = DM.EXE      ; optional = true
    file[]: crc = e272977c; size =      6397; name = DM.TXT      ; optional = true
    file[]: crc = ffa4a9af; size =     65021; name = DWANGO.EXE  ; optional = true
    file[]: crc = 9429e073; size =      2536; name = DWANGO.STR  ; optional = true
    file[]: crc = 039525a3; size =     10623; name = DWANGO.TXT  ; optional = true
    file[]: crc = 499749d7; size =    717239; name = HERETIC.EXE
    file[]: crc = 77482d1e; size =  11096488; name = HERETIC.WAD
    file[]: crc = c4cd13b0; size =     17971; name = IPXSETUP.EXE; optional = true
    file[]: crc = d31b3e59; size =        50; name = MODEM.CFG   ; optional = true
    file[]: crc = b5d192a9; size =        33; name = MODEM.NUM   ; optional = true
    file[]: crc = 8a8dd2ec; size =      3048; name = MODEM.STR   ; optional = true
    file[]: crc = 9dbb9b52; size =     20257; name = SERSETUP.EXE; optional = true
    file[]: crc = bb2a8640; size =     47094; name = SETUP.EXE   ; optional = true
end

//
// v1.0, Shareware
//
demo[v1.0-sw]:
    name = v1.0, Shareware
    imports = v1.0
    file[]: crc = a3a3758f; size =    717239; name = HERETIC.EXE
    file[]: remove = HERETIC.WAD
    file[]: crc = 884a3e45; size =   5120300; name = HERETIC1.WAD
end

//
// v1.0, CD, Installer
//
installer[v1.0-cd-installer]:
    name = v1.0, CD, Installer
    installid = v1.0
    mips = $(MIPS_MAX)
    launch = DREAMM10.BAT
    anchorfile = HREG_V10.4
    file[]: crc = 106fef98; size =   1439232; name = HREG_V10.1
    file[]: crc = e6fc9905; size =   1457664; name = HREG_V10.2
    file[]: crc = c18b8fac; size =   1457664; name = HREG_V10.3
    file[]: crc = 38f9a52b; size =   1444781; name = HREG_V10.4
end

//
// v1.2, Shareware
//
game[v1.2-sw]:
    name = v1.2, Shareware
    imports = v1.0
    file[]: crc = baaab071; size =     20937; name = DM.EXE      ; optional = true
    file[]: crc = a8c969ce; size =     73621; name = DWANGO.EXE  ; optional = true
    file[]: crc = 86846150; size =       328; name = DWANGO.SRV  ; optional = true
    file[]: crc = 433ece18; size =     11197; name = DWANGO.TXT  ; optional = true
    file[]: crc = 236ae36c; size =       462; name = FILE_ID.DIZ ; optional = true
    file[]: crc = e8a84e57; size =    728031; name = HERETIC.EXE
    file[]: remove = HERETIC.WAD
    file[]: crc = 22d3f0ca; size =   5120920; name = HERETIC1.WAD
    file[]: crc = 69eb04d5; size =     78639; name = HTICSAV0.HSG; optional = true
    file[]: crc = bc5e2121; size =     54779; name = PATCH.EXE   ; optional = true
    file[]: crc = ed4a5c2c; size =    533824; name = PATCH.RTP   ; optional = true
    file[]: crc = d2102603; size =        78; name = PSHELL.CFG  ; optional = true
    file[]: crc = f0e47fa9; size =     87355; name = PSHELL.EXE  ; optional = true
    file[]: crc = ac8af939; size =       965; name = PSHELL.TXT  ; optional = true
    file[]: crc = 7b379c84; size =     47096; name = SETUP.EXE   ; optional = true
    file[]: crc = 2a85dfa2; size =     19203; name = VIOHT.EXE   ; optional = true
end

//
// v1.3, Shadow of the Serpent Riders
//
game[v1.3]:
    name = v1.3, Shadow of the Serpent Riders
    launch = $(rootpath)\XXHRTIC.EXE -config $(CONFIG_FILE)
    anchorfile = HERETIC.WAD
    file[]: crc = 5b16049e; size =  14189976; name = HERETIC.WAD
    file[]: crc = 2a85dfa2; size =     19203; name = VIOHT.EXE
    file[]: crc = 3b15558c; size =    728031; name = XXHRTIC.EXE
    file[]: crc = 204b921d; size =     43325; name = XXSETUP.EXE
end

end