    file[]: crc = af85ddc2; size =    696081; name = DISK3\SOD.9; exactonly = true
end

//
// v1.4
//
game[v1.4]:
    name = v1.4
    imports = v1.0-3x720k
    anchorfile = SPEAR.EXE
    file[]: crc = f8dd4a07; size =    112835; name = SPEAR.EXE
end

