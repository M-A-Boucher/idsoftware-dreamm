//
// Catacomb 3-D: The Abyss
//
desc[ids-catacomb3d-abyss]:

name = Catacomb 3-D: The Abyss
icon = ids-catacomb3d-abyss.png
machine = pc
osenv = dos
rootpath = C:\
launch = $(rootpath)\CATABYSS.EXE
mips = $(MIPS_386SX_20)
ramkb = 8192
filter = id software, softdisk, fps

//
// graphics configuration
//
config[graphics]:
    title = Graphics Configuration
    option[ega]:
        name = $(EGA_NAME); priority = 1
        videohw = ega
    end
    option[vga]:
        name = $(VGA_NAME)
        videohw = vga
    end
end

//
// sound configuration
//
config[sound]:
    title = Sound Configuration
    option[speaker]:
        name = $(SPEAKER_NAME)
        audiohw = speaker
    end
    option[adlib]:
        name = $(ADLIB_NAME); priority = 1
        audiohw = adlib
    end
    option[sb16]:
        name = $(SB16_NAME)
        audiohw = sb16
    end
end

//
// filesystem
//
mount[]: vpath = C:\;         srcpath = $(ifsdeltapath); writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath);

//
// The Abyss
//
game[abyss]:
    name = The Abyss
    anchorfile = CATABYSS.EXE
    file[]: crc = 5f0319db; size =     82479; name = ABYSGAME.EXE
    file[]: crc = 66a11ac1; size =      7886; name = AQUDUCT.HNT
    file[]: crc = 462d2eb2; size =      6904; name = AUDIO.ABS
