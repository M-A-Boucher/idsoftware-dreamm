//
// Catacomb II
//
desc[ids-catacomb2]:

name = Catacomb II
icon = ids-catacomb2.png
machine = pc
osenv = dos
rootpath = C:\
launch = $(rootpath)\CATACOMB.EXE
mips = 1
ramkb = 1024
filter = id software, softdisk, action
audiohw = speaker

//
// graphics configuration
//
config[graphics]:
    title = Graphics Configuration
    option[cga]:
        name = $(CGA_NAME)
        videohw = cga
    end
    option[ega]:
        name = $(EGA_NAME); priority = 1
        videohw = ega
    end
end

//
// filesystem
//
mount[]: vpath = C:\;         srcpath = $(ifsdeltapath); writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath);

//
// Anthology?
//
game[anthology]:
    name = Anthology?
    anchorfile = CATACOMB.EXE
    file[]: crc = b6863c6b; size =     33553; name = CATACOMB.EXE
    file[]: crc = bf7581e2; size =     25888; name = CGACHARS.CA2
