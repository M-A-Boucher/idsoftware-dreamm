//
// Doom 95
//
desc[ids-doom95]:

name = Doom 95
icon = ids-doom.png
machine = pc
rootpath = C:\
launch = "$(rootpath)\Doom95.exe" $(BASEWAD) $(MONSTER) $(SKILL) $(WARP) $(RESOLUTION) -nosfxformat
filter = nonlucas, netplay
osenv = windows 95
audiohw = gmidi
winres = 640x480x8
BASEWAD = ""
MONSTER = ""
SKILL = ""
GAMEID = 0
SKILLSTART = 0
WARP = ""

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// Registry
//
REGISTRY = [[[$(CRLF)
		REGEDIT4
		[HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\MediaResources\Joystick\Joystick\CurrentJoystickSettings]
		@=
		[HKEY_CURRENT_USER\SOFTWARE\id\Doom95\Session]
		"(Default)"=""
		"cdrom"=?dword:00000000
		"customwad"=?""
		"deathmatch"=?dword:00000000
		"demosize"=?dword:00000000
		"fastparm"=?dword:00000000
		"fullscreen"=?dword:00000001
		"gamename"=?"DREAMM"
		"IPXport"=?dword:00000000
		"loadgame"=?dword:00000000
		"maxnumplayers"=?dword:00000000
		"nomonsters"=?dword:00000000
		"onetdll"=?""
		"onetstring"=?"r"
		"playdemo"=?dword:00000000
		"playdemofile"=?""
		"playeralias"=?"DREAMMPlayer"
		"recorddemo"=?dword:00000000
		"recorddemofile"=?"dreammdemo"
		"respawnparm"=?dword:00000000
		"screenrez"=?dword:00000003
		"startepisode"=?dword:00000004
		"startmap"=?dword:00000004
		"startskill"=?dword:00000004
		"timer"=?dword:00000000
		"timervalue"=?dword:00000002
		"turbo"=?dword:00000000
		"turbovalue"=?dword:0000000a
		"wadfile"=?"DOOM.WAD"
		[HKEY_CURRENT_USER\SOFTWARE\ID\Doom95\Config]
		@=
		"joy_advanced"=?dword:00000001
		"joy_id"=?dword:00000000
		"use_joystick"=?dword:00000001
		"joyb_use"=?dword:00000003
		"joyb_fire"=?dword:00000000
		"joyb_speed"=?dword:00000001
		"joyb_strafe"=?dword:00000002
		
		]]]

script[init]:
    code = [[[$(CRLF)
        winregistry_import_raw("$$(REGISTRY)");
    ]]]
end

//
// Game Launch
//
config[gametype]:
    title = Game Mode
    option[launcher]:  name = Launcher; BASEWAD = ""; MONSTER = ""; SKILL = ""; GAMEID = 0; SKILLSTART = 0; WARP = ""; RESOLUTION = ""; priority = 1
	option[doom1]: name = Doom Shareware (DOOM1.WAD); BASEWAD = -nodm -basewad doom1.wad; condition = file_exists("$$(rootpath)\\doom1.wad"); GAMEID = 1
	option[doomua]: name = The Ultimate Doom (DOOM.WAD); BASEWAD = -nodm -basewad doom.wad; condition = (file_exists("$$(rootpath)\\doom.wad")); GAMEID = 2
	option[doomub]: name = The Ultimate Doom (DOOMU.WAD); BASEWAD = -nodm -basewad doomu.wad; condition = file_exists("$$(rootpath)\\doomu.wad"); GAMEID = 6
	option[doom2]: name = Doom II Hell on Earth (DOOM2.WAD); BASEWAD = -nodm -basewad doom2.wad; condition = (file_exists("$$(rootpath)\\doom2.wad")); GAMEID = 3
	option[doom2f]: name = Doom II L'Enfer sur Terre (DOOM2F.WAD); BASEWAD = -nodm -basewad doom2f.wad; condition = (file_exists("$$(rootpath)\\doom2f.wad")); GAMEID = 3
	option[doom2m]: name = Master Levels for Doom II (DOOM2.WAD); BASEWAD = -nodm -basewad doom2.wad; condition = (file_exists("$$(rootpath)\\doom2.wad")) && (file_exists("$$(rootpath)\\MASTER\\wads\\attack.wad")); GAMEID = 7
	option[doom2mf]: name = Master Levels for Doom IIF (DOOM2F.WAD); BASEWAD = -nodm -basewad doom2f.wad; condition = (file_exists("$$(rootpath)\\doom2f.wad")) && (file_exists("$$(rootpath)\\MASTER\\wads\\attack.wad")); GAMEID = 7
	option[plutonia]: name = The Plutonia Experiment (PLUTONIA.WAD); BASEWAD = -nodm -basewad plutonia.wad; condition = file_exists("$$(rootpath)\\plutonia.wad"); GAMEID = 4
	option[tnt]: name = TNT Evilution (TNT.WAD); BASEWAD = -nodm -basewad tnt.wad; condition = file_exists("$$(rootpath)\\tnt.wad"); GAMEID = 5
	option[tnt31]: name = TNT Evilution w/ TNT31 (TNT.WAD + TNT31.WAD); BASEWAD = -nodm -basewad tnt.wad -file tnt31.wad -nowarn; condition = file_exists("$$(rootpath)\\tnt.wad") && file_exists("$$(rootpath)\\tnt31.wad"); GAMEID = 5
	
end

//
// SKILL
//
config[skill]:
	condition = ("$$(GAMEID)" != 0)
    title = SKILL LEVEL
	option[skilloff]: name = Normal Start. ; SKILL = ""; priority = 1; SKILLSTART = 0; MONSTER = ""; WARP = ""; priority = 1; condition = "$$(GAMEID)" != 7
    option[skill1]: name = I'M TOO YOUNG TO DIE. (SKILL1); SKILL = -SKILL 1; SKILLSTART = 2
	option[skill2]: name = HEY, NOT TOO ROUGH. (SKILL2); SKILL = -SKILL 2; SKILLSTART = 2
    option[skill3]: name = HURT ME PLENTY. (SKILL3); SKILL = -SKILL 3; SKILLSTART = 2
	option[skill4]: name = ULTRA-VIOLENCE. (SKILL4); SKILL = -SKILL 4; SKILLSTART = 2
	option[skill5]: name = NIGHTMARE! (SKILL5); SKILL = -SKILL 5; SKILLSTART = 2
	option[skill0]: name = NO THINGS. (SKILL0); SKILL = -SKILL 0; SKILLSTART = 1
	
end

//
// Monster Toggle (Off/On/Fast/Respawn)
//
config[monster]:
	condition = ("$$(GAMEID)" != 0) && ("$$(SKILLSTART)" > 1)
    title = Monsters
    option[off]:  name = Off; MONSTER = -NOMONSTERS
	option[on]: name = On (Normal); MONSTER = ""; priority = 1
    option[fast]: name = On + Fast Monsters; MONSTER = -FAST
	option[respawn]: name = On + Respawn Monsters; MONSTER = -RESPAWN
	option[both]: name = On + Fast & Respawn Monsters; MONSTER = -FAST -RESPAWN
	
end

//
// Doom / Ultimate Doom
//
config[d1map]:
	condition = ("$$(SKILLSTART)" > 0) && (("$$(GAMEID)" == 1) || ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6))
    title = Start on D1Map
    option[warp11]: name = E1M1 HANGAR; WARP = -WARP 1 1; priority = 1
	option[warp12]: name = E1M2 NUCLEAR PLANT; WARP = -WARP 1 2
    option[warp13]: name = E1M3 TOXIN REFINERY; WARP = -WARP 1 3
	option[warp14]: name = E1M4 COMMAND CONTROL; WARP = -WARP 1 4
	option[warp15]: name = E1M5 PHOBOS LAB; WARP = -WARP 1 5
	option[warp16]: name = E1M6 CENTRAL PROCESSING; WARP = -WARP 1 6
	option[warp17]: name = E1M7 COMPUTER STATION; WARP = -WARP 1 7
	option[warp18]: name = E1M8 PHOBOS ANOMALY; WARP = -WARP 1 8
	option[warp19]: name = E1M9 MILITARY BASE; WARP = -WARP 1 9
    option[warp21]: name = E2M1 DEIMOS ANOMALY; WARP = -WARP 2 1; condition = ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6)
	option[warp22]: name = E2M2 CONTAINMENT AREA; WARP = -WARP 2 2; condition = ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6)
    option[warp23]: name = E2M3 REFINERY; WARP = -WARP 2 3; condition = ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6)
	option[warp24]: name = E2M4 DEIMOS LAB; WARP = -WARP 2 4; condition = ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6)
	option[warp25]: name = E2M5 COMMAND CENTER; WARP = -WARP 2 5; condition = ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6)
	option[warp26]: name = E2M6 HALLS OF THE DAMNED; WARP = -WARP 2 6; condition = ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6)
	option[warp27]: name = E2M7 SPAWNING VATS; WARP = -WARP 2 7; condition = ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6)
	option[warp28]: name = E2M8 TOWER OF BABEL; WARP = -WARP 2 8; condition = ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6)
	option[warp29]: name = E2M9 FORTRESS OF MYSTERY; WARP = -WARP 2 9; condition = ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6)
    option[warp31]: name = E3M1 HELL KEEP; WARP = -WARP 3 1; condition = ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6)
	option[warp32]: name = E3M2 SLOUGH OF DESPAIR; WARP = -WARP 3 2; condition = ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6)
    option[warp33]: name = E3M3 PANDEMONIUM; WARP = -WARP 3 3; condition = ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6)
	option[warp34]: name = E3M4 HOUSE OF PAIN; WARP = -WARP 3 4; condition = ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6)
	option[warp35]: name = E3M5 UNHOLY CATHEDRAL; WARP = -WARP 3 5; condition = ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6)
	option[warp36]: name = E3M6 MT. EREBUS; WARP = -WARP 3 6; condition = ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6)
	option[warp37]: name = E3M7 GATE TO LIMBO; WARP = -WARP 3 7; condition = ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6)
	option[warp38]: name = E3M8 DIS; WARP = -WARP 3 8; condition = ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6)
	option[warp39]: name = E3M9 WARRENS; WARP = -WARP 3 9; condition =  ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6)
    option[warp41]: name = E4M1 HELL BENEATH; WARP = -WARP 4 1; condition =  ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6)
	option[warp42]: name = E4M2 PERFECT HATRED; WARP = -WARP 4 2; condition = ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6)
    option[warp43]: name = E4M3 SEVER THE WICKED; WARP = -WARP 4 3; condition = ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6)
	option[warp44]: name = E4M4 UNRULY EVIL; WARP = -WARP 4 4; condition = ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6)
	option[warp45]: name = E4M5 THEY WILL REPENT; WARP = -WARP 4 5; condition = ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6)
	option[warp46]: name = E4M6 AGAINST THEE WICKEDLY; WARP = -WARP 4 6; condition = ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6)
	option[warp47]: name = E4M7 AND HELL FOLLOWED; WARP = -WARP 4 7; condition = ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6)
	option[warp48]: name = E4M8 UNTO THE CRUEL; WARP = -WARP 4 8; condition = ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6)
	option[warp49]: name = E4M9 FEAR; WARP = -WARP 4 9; condition = ("$$(GAMEID)" == 2) || ("$$(GAMEID)" == 6)

end

//
// Doom 2 Map
//
config[d2map]:
