//
// Anthology, Installer
//
installer[anthology-installer]:
    name = Anthology, Installer
    installid = v1.0
    mips = $(MIPS_MAX)
    launch = HOVERINS.EXE
    anchorfile = HOVERINS.EXE
    file[]: crc = f28ba1bd; size =    269123; name = HOVERINS.EXE
end

end