//
// Strife
//
desc[ids-strife]:

name = Strife
icon = ids-strife.png
machine = pc
osenv = dos
rootpath = C:\
EXEC = STRIFE.BAT
mips = $(MIPS_486DX4_100)
ramkb = 8192
videohw = vga
audiohw = sb16+$(MUSICHW)
filter = rogue, velocity, fps, rpg

$(include cfg-doom.inc)
CONFIG_FILE = STRIFE.CFG
NOENDDOOM = true

//
// filesystem
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)  ; writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// v1.0
//
game[v1.0]:
    name = v1.0
    anchorfile = STRIFE1.EXE
    file[]: crc = 35b75b1e; size =     23008; name = AVI.EXE
    file[]: crc = 9b4d6182; size =     30724; name = IPXSETUP.EXE; optional = true
    file[]: crc = e4f84b43; size =        67; name = MODEM.CFG   ; optional = true
    file[]: crc = 264c0c20; size =        67; name = MODEM.NUM   ; optional = true
    file[]: crc = a320697b; size =      3405; name = MODEM.STR   ; optional = true
    file[]: crc = bd12c1d5; size =     16719; name = MULTI.TXT   ; optional = true
    file[]: crc = 0b3dd180; size =     33986; name = SERSETUP.EXE; optional = true
    file[]: crc = 9573ab1b; size =  11873080; name = STRIFE.AVI
    file[]: crc = cabec14d; size =        25; name = STRIFE.BAT
    file[]: crc = f881033d; size =    753291; name = STRIFE1.EXE
    file[]: crc = b7581abd; size =  28372168; name = STRIFE1.WAD
    file[]: crc = 4fecefc4; size =        24; name = VERSION.TXT ; optional = true
    file[]: crc = cd12ebcf; size =  27319149; name = VOICES.WAD
end

demo[demo]:
    name = Demo
    EXEC = STRIFE.EXE
    anchorfile = STRIFE.EXE
    file[]: crc = 1db8ca38; size =    720397; name = STRIFE.EXE
    file[]: crc = 3a6ab94d; size =  10493652; name = STRIFE0.WAD
end

end
