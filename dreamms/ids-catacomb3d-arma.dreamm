//
// Catacomb 3-D: Armageddon
//
desc[ids-catacomb3d-arma]:

name = Catacomb 3-D: Armageddon
icon = ids-catacomb3d-arma.png
machine = pc
osenv = dos
rootpath = C:\
launch = $(rootpath)\CATARM.EXE
mips = $(MIPS_386SX_20)
ramkb = 8192
filter = id software, softdisk, fps

//
// graphics configuration
//
config[graphics]:
    title = Graphics Configuration
    option[ega]:
        name = $(EGA_NAME); priority = 1
        videohw = ega
    end
    option[vga]:
        name = $(VGA_NAME)
        videohw = vga
    end
end

//
// sound configuration
//
config[sound]:
    title = Sound Configuration
    option[speaker]:
        name = $(SPEAKER_NAME)
        audiohw = speaker
    end
    option[adlib]:
        name = $(ADLIB_NAME); priority = 1
        audiohw = adlib
    end
    option[sb16]:
        name = $(SB16_NAME)
        audiohw = sb16
    end
end

//
// filesystem
//
mount[]: vpath = C:\;         srcpath = $(ifsdeltapath); writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath);

//
// Armageddon
//
game[armageddon]:
    name = Armageddon
    anchorfile = CATARM.EXE
    file[]: crc = 46df909b; size =     50288; name = ARM_SLIB.ARM
    file[]: crc = 7bf5e3d5; size =     82198; name = ARMGAME.EXE
    file[]: crc = b6c28bc7; size =      7104; name = AUDIO.ARM
    file[]: crc = 5e40ecaf; size =     16749; name = CATARM.EXE
    file[]: crc = 4db59d45; size =       474; name = CONFIG.ARM  ; optional = true
    file[]: crc = 1a2edcbb; size =     20714; name = DOCSHELL.EXE
