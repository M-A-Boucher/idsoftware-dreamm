//
// Commander Keen in “Aliens Ate My Babysitter!”
//
desc[ids-keen6]:

name = Commander Keen in “Aliens Ate My Babysitter!”
icon = ids-keen6.png
machine = pc
osenv = dos
rootpath = C:\
launch = KEEN6.EXE
mips = $(MIPS_386DX_33)
nothrottle = 2
ramkb = 8192
filter = id software, action
audiohw = sb16

//
// graphics configuration
//
config[graphics]:
    title = Graphics Configuration
    option[cga]:
        name = $(CGA_NAME)
        videohw = cga
        condition = file_exists("$$(rootpath)\\CGAGRAPH.CK6")
    end
    option[ega]:
        name = $(EGA_NAME); priority = 1
        videohw = ega
    end
    option[vga]:
        name = $(VGA_NAME)
        videohw = vga
    end
end

dynamicfile[]:
    path = $(rootpath)\DREAMMC.BAT
    contents = [[[$(CRLF)
        CK6-1C.EXE
        CK6-2C.EXE
        CK6-3.EXE
        CK6-4.EXE
    ]]]
end

dynamicfile[]:
    path = $(rootpath)\DREAMMV.BAT
    contents = [[[$(CRLF)
        CK6-1V.EXE
        CK6-2V.EXE
        CK6-3.EXE
        CK6-4.EXE
    ]]]
end

//
// filesystem
//
mount[]: vpath = C:\;         srcpath = $(ifsdeltapath); writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath);

//
// v1.0, CGA
//
game[v1.0-cga]:
    name = v1.0, CGA
    anchorfile = KEEN6.EXE
    file[]: crc = 472e62f3; size =     56265; name = AUDIO.CK6
    file[]: crc = 39d32d6e; size =    311897; name = CGAGRAPH.CK6
    file[]: crc = 40f298f8; size =     95421; name = GAMEMAPS.CK6
    file[]: crc = a392f517; size =     98614; name = KEEN6.EXE
end

//
// v1.0, 2x720K, CGA, Installer
//
installer[v1.0-2x720k-cga-installer]:
    name = v1.0, 2x720K, CGA, Installer
    installid = v1.0-cga
    mips = $(MIPS_MAX)
    launch = DREAMMC.BAT
    anchorfile = CK6-1C.EXE
    file[]: crc = ccd2ba6e; size =     93832; name = CK6-1C.EXE
    file[]: crc = c18edbe7; size =    204122; name = CK6-2C.EXE
    file[]: crc = 741c7a78; size =     69092; name = CK6-3.EXE
    file[]: crc = bbc31457; size =     46935; name = CK6-4.EXE
end

//
// v1.0, EGA
//
game[v1.0-ega]:
    name = v1.0, EGA
    anchorfile = KEEN6.EXE
    file[]: crc = 472e62f3; size =     56265; name = AUDIO.CK6
    file[]: crc = fe555279; size =    457309; name = EGAGRAPH.CK6
    file[]: crc = 40f298f8; size =     95421; name = GAMEMAPS.CK6
    file[]: crc = ec76900b; size =    104938; name = KEEN6.EXE
end

//
// v1.0, 2x720K, EGA, Installer
//
installer[v1.0-2x720k-ega-installer]:
    name = v1.0, 2x720K, EGA, Installer
    installid = v1.0-ega
    mips = $(MIPS_MAX)
    launch = DREAMMV.BAT
    anchorfile = CK6-1V.EXE
    file[]: crc = 66afdb42; size =    100433; name = CK6-1V.EXE
    file[]: crc = 3a5af0b8; size =    323773; name = CK6-2V.EXE
    file[]: crc = 741c7a78; size =     69092; name = CK6-3.EXE
    file[]: crc = bbc31457; size =     46935; name = CK6-4.EXE
end

//
// v1.4, CGA
//
game[v1.4-cga]:
    name = v1.4, CGA
    imports = v1.0-cga
    file[]: crc = ce7867b4; size =    311706; name = CGAGRAPH.CK6
    file[]: crc = 9c04b31e; size =     95541; name = GAMEMAPS.CK6
    file[]: crc = f36a4c51; size =    100964; name = KEEN6.EXE
end

