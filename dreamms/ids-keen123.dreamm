//
// Commander Keen in “Invasion of the Vorticons”
//
desc[ids-keen123]:

name = Commander Keen in “Invasion of the Vorticons”
icon = ids-keen123.png
machine = pc
osenv = dos
rootpath = C:\
mips = $(MIPS_386SX_20)
nothrottle = 2
ramkb = 1024
filter = id software, action
audiohw = adlib

//
// episode configuration
//
config[episode]:
    title = Episode Configuration
    option[episode1]:
        name = Episode 1: Marooned on Mars
        condition = file_exists("$$(rootpath)\\KEEN1.EXE")
        launch = KEEN1.EXE
    end
    option[episode2]:
        name = Episode 2: The Earth Explodes
        condition = file_exists("$$(rootpath)\\KEEN2.EXE")
        launch = KEEN2.EXE
    end
    option[episode3]:
        name = Episode 3: Keen Must Die!
        condition = file_exists("$$(rootpath)\\KEEN3.EXE")
        launch = KEEN3.EXE
    end
end

//
// graphics configuration
//
config[graphics]:
    title = Graphics Configuration
    option[ega]:
        name = $(EGA_NAME); priority = 1
        videohw = ega
    end
    option[vga]:
        name = $(VGA_NAME)
        videohw = vga
    end
end

dynamicfile[]:
    path = $(rootpath)\DREAMM.BAT
    contents = [[[$(CRLF)
        COPY KEEN123.1+KEEN123.2 KEEN123.EXE
        KEEN123.EXE
    ]]]
end

//
// filesystem
//
mount[]: vpath = C:\;         srcpath = $(ifsdeltapath); writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath);

//
// v1.0 
//
game[v1.0]:
