//
// Rescue Rover
//
desc[ids-rover1]:

name = Rescue Rover
icon = ids-rover1.png
machine = pc
osenv = dos
rootpath = C:\
launch = $(rootpath)\ROVER.EXE
mips = $(MIPS_386DX_33)
ramkb = 4096
filter = id software, soft disk, puzzle
audiohw = speaker

//
// graphics configuration
//
config[graphics]:
    title = Graphics Configuration
    option[ega]:
        name = $(EGA_NAME); priority = 1
        videohw = ega
    end
    option[vga]:
        name = $(VGA_NAME)
        videohw = vga
    end
end

//
// filesystem
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)  ; writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// Rover
//
game[rover]:
    name = Rover
    launch = ROVER.EXE
    anchorfile = ROVER.EXE
    file[]: crc = 8bdbd897; size =        42; name = CTLPANEL.ROV
    file[]: crc = cd1cff7d; size =     12288; name = EGABTILE.ROV
    file[]: crc = d41d97e4; size =      3130; name = EGAFONT0.ROV
