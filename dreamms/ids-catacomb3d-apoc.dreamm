//
// Catacomb 3-D: Apocalypse
//
desc[ids-catacomb3d-apoc]:

name = Catacomb 3-D: Apocalypse
icon = ids-catacomb3d-apoc.png
machine = pc
osenv = dos
rootpath = C:\
launch = $(rootpath)\CAT3D.EXE
mips = $(MIPS_386SX_20)
ramkb = 8192
filter = id software, softdisk, fps

//
// graphics configuration
//
config[graphics]:
    title = Graphics Configuration
    option[ega]:
        name = $(EGA_NAME); priority = 1
        videohw = ega
    end
    option[vga]:
        name = $(VGA_NAME)
        videohw = vga
    end
end

//
// sound configuration
//
config[sound]:
    title = Sound Configuration
    option[speaker]:
        name = $(SPEAKER_NAME)
        audiohw = speaker
    end
    option[adlib]:
        name = $(ADLIB_NAME); priority = 1
        audiohw = adlib
    end
    option[sb16]:
        name = $(SB16_NAME)
        audiohw = sb16
    end
end

//
// filesystem
//
mount[]: vpath = C:\;         srcpath = $(ifsdeltapath); writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath);

//
// Apocalypse
//
game[apocalypse]:
    name = Apocalypse
    launch = CATAPOC.EXE
    anchorfile = CATAPOC.EXE
    file[]: crc = 48ca6808; size =     82386; name = APOCGAME.EXE
    file[]: crc = 23934cec; size =      7366; name = AUDIO.APC
    file[]: crc = f517500e; size =     16710; name = CATAPOC.EXE
    file[]: crc = 8e280785; size =       474; name = CONFIG.APC  ; optional = true
    file[]: crc = 1a2edcbb; size =     20714; name = DOCSHELL.EXE
    file[]: crc = 291893c3; size =    382078; name = EGAGRAPH.APC
