script[cp]:
    condition = is_game();
    code = [[[$(CRLF)
        cpactive = "";

        func update()
        {
          if (!script_running(cpscript))
          {
            match = scraper_match("BZmTNmans", "$$(FINGERPRINTS)");
            question = scraper_string("DAAg9@@lIAAlI@@pSAApS@@tc", "id", 0x13);


            if (match != "" || question != "")
            {

              answer = strmap(question, "$$(CPANSWERS)");
              answer = answer + match;

              if (answer != "" && cpactive == "")
              {
                echo("Question: " + question);
                echo("Answer: " + answer);
                cpactive = answer;

                if (!prop("noautocp"))
                  cpscript = script_run_async("cpauto", answer+"\r");

                if (!prop("notextcp"))
                  overlay_show("cpoverlay", -1, "The answer is: " + answer);
              }
            }
            else
            {
              cpactive = "";
              overlay_hide("cpoverlay");
            }
          }
        }

        func cpauto(value)
        {
          input_lockout(true);
          sleep(500);
          keyboard_type(value);
          sleep(500);
          input_lockout(false);
        }
    ]]]
end
